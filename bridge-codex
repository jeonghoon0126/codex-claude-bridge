#!/bin/sh
# bridge-codex <ROOM_ID>
# Codex CLI를 Codex Bridge 룸에 연결해서 실행한다.
#
# Usage:
#   bridge-codex ENG-1234

ROOM="${1}"
WORKDIR="${CODEX_BRIDGE_CWD:-$PWD}"
CODEX_BIN="${CODEX_BIN:-/Users/wjh/.local/bin/codex}"

if [ -z "$ROOM" ]; then
  echo "usage: bridge-codex <ROOM_ID>" >&2
  echo "  e.g. bridge-codex ENG-1234" >&2
  exit 1
fi

printf "%s" "$ROOM" > "/tmp/codex-bridge-room-$$"
printf "\033]0;LEADER-%s\007" "$ROOM"
export CODEX_BRIDGE_ROOM="$ROOM"
cd "$WORKDIR" || exit 1
/Users/wjh/.bun/bin/bun /Users/wjh/codex-claude-bridge/covering-bridge.ts tmux-pane-titles --start >/dev/null 2>&1 || true
exec "$CODEX_BIN" --sandbox danger-full-access -a never
