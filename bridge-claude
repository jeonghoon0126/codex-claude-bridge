#!/bin/sh
# bridge-claude <ROOM_ID>
# Claude Code를 Codex Bridge 룸에 연결해서 실행한다.
#
# Usage:
#   bridge-claude ENG-1234

ROOM="${1}"
WORKDIR="${CODEX_BRIDGE_CWD:-$PWD}"
CLAUDE_BIN="${CLAUDE_BIN:-/Users/wjh/.local/bin/claude}"

if [ -z "$ROOM" ]; then
  echo "usage: bridge-claude <ROOM_ID>" >&2
  echo "  e.g. bridge-claude ENG-1234" >&2
  exit 1
fi

printf "%s" "$ROOM" > "/tmp/claude-bridge-room-$$"
export CODEX_BRIDGE_ROOM="$ROOM"
cd "$WORKDIR" || exit 1
exec "$CLAUDE_BIN" --dangerously-load-development-channels server:codex-bridge
