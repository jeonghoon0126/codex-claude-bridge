#!/bin/zsh
set -euo pipefail

HOME_DIR="${HOME:-/Users/wjh}"
BRIDGE_DIR="${CBRIDGE_DIR:-$HOME_DIR/codex-claude-bridge}"
RESTORE_NOW_SCRIPT="$BRIDGE_DIR/scripts/cbridge-restore-now"
TERMINAL_INPUT_HELPER_SCRIPT="$BRIDGE_DIR/scripts/cbridge-terminal-input-helper"
LOAD_GOVERNOR_SCRIPT="$BRIDGE_DIR/scripts/cbridge-load-governor"
TMUX_BIN="${TMUX_BIN:-/opt/homebrew/bin/tmux}"
LEADERS_SESSION="${CBRIDGE_RESTORE_LEADERS_SESSION:-cbridge-leaders-main}"
LEADER_TAB_SESSION_PREFIX="${CBRIDGE_RESTORE_LEADER_TAB_SESSION_PREFIX:-cbridge-leaders-tab}"
GOVERNOR_SESSION="${CBRIDGE_TERMINAL_GOVERNOR_SESSION:-cbridge-terminal-load-governor}"
GOVERNOR_LABEL="${CBRIDGE_GOVERNOR_LAUNCHD_LABEL:-com.wjh.cbridge-load-governor}"
TERMINAL_OPEN_WAIT_SECONDS="${CBRIDGE_TERMINAL_OPEN_WAIT_SECONDS:-5}"
FOCUS_APP_STATE="$HOME_DIR/.codex-claude-bridge/focus-app"
TERMINAL_TABS_STATE="$HOME_DIR/.codex-claude-bridge/terminal-tabs-ready"
ACTIVE_WINDOWS_STATE="$HOME_DIR/.codex-claude-bridge/active-leader-windows"

if [[ ! -x "$RESTORE_NOW_SCRIPT" ]]; then
  printf 'missing restore script: %s\n' "$RESTORE_NOW_SCRIPT" >&2
  exit 1
fi

if [[ ! -x "$TERMINAL_INPUT_HELPER_SCRIPT" ]]; then
  printf 'missing Terminal input helper: %s\n' "$TERMINAL_INPUT_HELPER_SCRIPT" >&2
  exit 1
fi

if [[ ! -x "$TMUX_BIN" ]]; then
  TMUX_BIN="$(command -v tmux || true)"
fi

if [[ -z "$TMUX_BIN" ]]; then
  printf 'tmux not found\n' >&2
  exit 1
fi

terminal_doctor() {
  local tab_count helper_state governor_state active_window
  tab_count="$(/usr/bin/osascript <<'APPLESCRIPT' 2>/dev/null || true
tell application "System Events"
  if not (exists process "Terminal") then return "0"
end tell
set maxTabs to 0
tell application "System Events"
  tell process "Terminal"
    repeat with w in windows
      set titleText to ""
      try
        set titleText to value of attribute "AXTitle" of w as text
      end try
      if titleText contains "cbridge" then
        repeat with itemRef in UI elements of w
          try
            if role of itemRef is "AXTabGroup" then
              set tabCount to count of (value of attribute "AXTabs" of itemRef)
              if tabCount > maxTabs then set maxTabs to tabCount
            end if
          end try
        end repeat
      end if
    end repeat
  end tell
end tell
return maxTabs as text
APPLESCRIPT
)"
  helper_state="꺼짐"
  pgrep -f "cbridge-terminal-input-helper --run ${TMUX_BIN}" >/dev/null 2>&1 && helper_state="켜짐"
  governor_state="꺼짐"
  if launchctl print "gui/$(id -u)/$GOVERNOR_LABEL" >/dev/null 2>&1 ||
    "$TMUX_BIN" has-session -t "$GOVERNOR_SESSION" >/dev/null 2>&1 ||
    pgrep -f "${LOAD_GOVERNOR_SCRIPT} --watch" >/dev/null 2>&1; then
    governor_state="켜짐"
  fi
  active_window="$(cat "$ACTIVE_WINDOWS_STATE" 2>/dev/null | tr -d '\n' || true)"
  [[ -n "$active_window" ]] || active_window="확인 전"

  printf 'Terminal 탭 %s개\n' "${tab_count:-0}"
  printf '입력 헬퍼 %s\n' "$helper_state"
  printf '성능 관리 %s\n' "$governor_state"
  printf '현재 리더 %s\n' "$active_window"
  if [[ -x "$LOAD_GOVERNOR_SCRIPT" ]]; then
    "$LOAD_GOVERNOR_SCRIPT" --status 2>/dev/null || true
  fi
}

start_terminal_load_governor() {
  [[ -x "$LOAD_GOVERNOR_SCRIPT" ]] || return 0
  mkdir -p "${ACTIVE_WINDOWS_STATE:h}"
  [[ -f "$ACTIVE_WINDOWS_STATE" ]] || printf 'A\n' > "$ACTIVE_WINDOWS_STATE"
  if launchctl print "gui/$(id -u)/$GOVERNOR_LABEL" >/dev/null 2>&1; then
    "$TMUX_BIN" has-session -t "$GOVERNOR_SESSION" >/dev/null 2>&1 &&
      "$TMUX_BIN" kill-session -t "$GOVERNOR_SESSION" >/dev/null 2>&1 || true
    return 0
  fi
  pgrep -f "${LOAD_GOVERNOR_SCRIPT} --watch" 2>/dev/null | while IFS= read -r pid; do
    [[ "$pid" == <-> ]] || continue
    [[ "$pid" == "$$" ]] && continue
    if ! "$TMUX_BIN" list-panes -a -F '#{pane_pid}' 2>/dev/null | grep -Fqx "$pid"; then
      kill "$pid" >/dev/null 2>&1 || true
    fi
  done
  "$TMUX_BIN" has-session -t "$GOVERNOR_SESSION" >/dev/null 2>&1 && return 0
  "$TMUX_BIN" new-session -d \
    -s "$GOVERNOR_SESSION" \
    -c "$BRIDGE_DIR" \
    "CBRIDGE_DIR=${BRIDGE_DIR:q} CBRIDGE_GOVERNOR_ACTIVE_WINDOWS_FILE=${ACTIVE_WINDOWS_STATE:q} CBRIDGE_GOVERNOR_LEADER_SESSIONS=${LEADERS_SESSION:q} CBRIDGE_GOVERNOR_INTERVAL_SECONDS=10 CBRIDGE_GOVERNOR_RESUME_TTL_SECONDS=900 ${LOAD_GOVERNOR_SCRIPT:q} --watch" \
    >/dev/null 2>&1 || true
}

case "${1:-}" in
  doctor|--doctor|status|--status)
    terminal_doctor
    exit 0
    ;;
esac

CBRIDGE_RESTORE_OPEN_WINDOWS=0 "$RESTORE_NOW_SCRIPT"
mkdir -p "${FOCUS_APP_STATE:h}"
printf 'Terminal\n' > "$FOCUS_APP_STATE"
if ! "$TERMINAL_INPUT_HELPER_SCRIPT"; then
  printf 'Terminal input helper could not start. Cmd+Enter newline and image Cmd+V may not work yet.\n' >&2
fi
start_terminal_load_governor

leader_windows() {
  "$TMUX_BIN" list-windows -t "$LEADERS_SESSION" -F '#{window_name}' 2>/dev/null || true
}

attach_command_for_window() {
  local window="$1" tab_session
  tab_session="$LEADER_TAB_SESSION_PREFIX-$window"
  printf 'printf "\\033]0;cbridge %s\\007"; exec %s attach -t %s' "$window" "${TMUX_BIN:q}" "${tab_session:q}"
}

typeset -a tab_args
typeset -a missing_tab_args
typeset -a existing_titles

terminal_tab_titles() {
  /usr/bin/osascript <<'APPLESCRIPT' 2>/dev/null || true
tell application "System Events"
  if not (exists process "Terminal") then return ""
end tell
tell application "Terminal"
  set out to ""
  repeat with w in windows
    repeat with t in tabs of w
      set customTitle to ""
      set tabName to ""
      try
        set customTitle to custom title of t as text
      end try
      try
        set tabName to name of t as text
      end try
      if customTitle starts with "cbridge " or tabName starts with "cbridge " then
        if customTitle starts with "cbridge " then
          set out to out & customTitle & linefeed
        else
          set out to out & tabName & linefeed
        end if
      end if
    end repeat
  end repeat
  return out
end tell
APPLESCRIPT
}

terminal_cbridge_system_tab_count() {
  /usr/bin/osascript <<'APPLESCRIPT' 2>/dev/null || true
tell application "System Events"
  if not (exists process "Terminal") then return "0"
end tell
set maxTabs to 0
tell application "System Events"
  tell process "Terminal"
    repeat with w in windows
      set titleText to ""
      try
        set titleText to value of attribute "AXTitle" of w as text
      end try
      if titleText contains "cbridge" then
        repeat with itemRef in UI elements of w
          try
            if role of itemRef is "AXTabGroup" then
              set tabCount to count of (value of attribute "AXTabs" of itemRef)
              if tabCount > maxTabs then set maxTabs to tabCount
            end if
          end try
        end repeat
      end if
    end repeat
  end tell
end tell
if maxTabs > 0 then return maxTabs as text

tell application "Terminal"
  set targetWindow to missing value
  repeat with w in windows
    repeat with t in tabs of w
      set customTitle to ""
      set tabName to ""
      try
        set customTitle to custom title of t as text
      end try
      try
        set tabName to name of t as text
      end try
      if customTitle starts with "cbridge A" or tabName starts with "cbridge A" then
        set targetWindow to w
        exit repeat
      end if
    end repeat
    if targetWindow is not missing value then exit repeat
  end repeat
  if targetWindow is missing value then return "0"
end tell
return "1"
APPLESCRIPT
}

terminal_tab_automation_enabled() {
  local enabled
  enabled="$(/usr/bin/osascript <<'APPLESCRIPT' 2>/dev/null || true
tell application "System Events"
  try
    return UI elements enabled as text
  on error
    return "false"
  end try
end tell
APPLESCRIPT
)"
  [[ "$enabled" == "true" ]]
}

terminal_has_non_cbridge_windows() {
  local count
  count="$(/usr/bin/osascript <<'APPLESCRIPT' 2>/dev/null || true
tell application "System Events"
  if not (exists process "Terminal") then return "0"
end tell
tell application "Terminal"
  set badCount to 0
  repeat with w in windows
    set hasCbridge to false
    set hasOther to false
    repeat with t in tabs of w
      set customTitle to ""
      set tabName to ""
      try
        set customTitle to custom title of t as text
      end try
      try
        set tabName to name of t as text
      end try
      if customTitle starts with "cbridge " or tabName starts with "cbridge " then
        set hasCbridge to true
      else
        set hasOther to true
      end if
    end repeat
    if hasOther and not hasCbridge then set badCount to badCount + 1
  end repeat
  return badCount as text
end tell
APPLESCRIPT
)"
  [[ "${count:-0}" != "0" ]]
}

terminal_tab_exists() {
  local title="$1" existing
  for existing in "${existing_titles[@]}"; do
    [[ "$existing" == "$title"* ]] && return 0
  done
  return 1
}

focus_terminal_tab() {
  local title="$1"
  [[ -n "$title" ]] || return 0
  /usr/bin/osascript - "$title" <<'APPLESCRIPT' >/dev/null 2>&1 || true
on run argv
  set targetTitle to item 1 of argv
  tell application "System Events"
    if not (exists process "Terminal") then return "0"
  end tell
  tell application "Terminal"
    repeat with w in windows
      repeat with t in tabs of w
        set customTitle to ""
        set tabName to ""
        try
          set customTitle to custom title of t as text
        end try
        try
          set tabName to name of t as text
        end try
        if customTitle starts with targetTitle or tabName starts with targetTitle then
          set selected tab of w to t
          set index of w to 1
          activate
          return "1"
        end if
      end repeat
    end repeat
  end tell
  return "0"
end run
APPLESCRIPT
}

existing_titles=("${(@f)$(terminal_tab_titles)}")
system_tab_count="$(terminal_cbridge_system_tab_count)"
system_tab_count="${system_tab_count:-0}"
for window in "${(@f)$(leader_windows)}"; do
  [[ -n "$window" ]] || continue
  if "$TMUX_BIN" has-session -t "$LEADER_TAB_SESSION_PREFIX-$window" 2>/dev/null; then
    title="cbridge $window"
    tab_args+=("$title" "$(attach_command_for_window "$window")")
    if ! terminal_tab_exists "$title"; then
      missing_tab_args+=("$title" "$(attach_command_for_window "$window")")
    fi
  fi
done

if (( ${#tab_args[@]} == 0 )); then
  printf 'Terminal attach skipped: no cbridge leader tabs found\n' >&2
  exit 1
fi

if (( ${system_tab_count:-0} >= ${#tab_args[@]} )) || [[ -f "$TERMINAL_TABS_STATE" && ${#missing_tab_args[@]} == 0 ]]; then
  focus_terminal_tab "${tab_args[1]}"
  printf 'cbridge leader tabs already open in Terminal.app\n'
  exit 0
fi

if (( ${system_tab_count:-0} < ${#tab_args[@]} )); then
  missing_tab_args=()
  for window in "${(@f)$(leader_windows)}"; do
    [[ -n "$window" ]] || continue
    if "$TMUX_BIN" has-session -t "$LEADER_TAB_SESSION_PREFIX-$window" 2>/dev/null; then
      title="cbridge $window"
      [[ "$title" == "cbridge A" ]] && continue
      missing_tab_args+=("$title" "$(attach_command_for_window "$window")")
    fi
  done
fi

if ! terminal_tab_automation_enabled; then
  /usr/bin/open "x-apple.systempreferences:com.apple.preference.security?Privacy_Accessibility" >/dev/null 2>&1 || true
  printf 'Terminal tab creation needs macOS Accessibility permission for the current terminal app. Enable it, then run cbridge-re-terminal again.\n' >&2
  exit 2
fi

osascript_log="$(mktemp /tmp/cbridge-terminal-tabs.XXXXXX)"
/usr/bin/osascript - "$HOME_DIR" "${missing_tab_args[@]}" >"$osascript_log" 2>&1 <<'APPLESCRIPT' &
on createNewTab()
    tell application "System Events"
      tell process "Terminal"
        key code 17 using command down
      end tell
    end tell
    delay 0.8
end createNewTab

on run argv
  set workDir to item 1 of argv
  tell application "Terminal"
    activate
    set targetWindow to missing value
    set fallbackWindow to missing value
    repeat with w in windows
      repeat with t in tabs of w
        set customTitle to ""
        set tabName to ""
        try
          set customTitle to custom title of t as text
        end try
        try
          set tabName to name of t as text
        end try
        if customTitle starts with "cbridge A" or tabName starts with "cbridge A" then
          set targetWindow to w
          exit repeat
        end if
        if fallbackWindow is missing value and (customTitle starts with "cbridge " or tabName starts with "cbridge ") then
          set fallbackWindow to w
        end if
      end repeat
      if targetWindow is not missing value then exit repeat
    end repeat
    if targetWindow is missing value then set targetWindow to fallbackWindow
    if targetWindow is missing value then
      set firstTitle to item 2 of argv
      set firstCommand to item 3 of argv
      do script ("cd " & quoted form of workDir & "; " & firstCommand)
      delay 0.35
      set targetWindow to front window
      try
        set custom title of selected tab of targetWindow to firstTitle
      end try
      set startIndex to 4
    else
      set index of targetWindow to 1
      delay 0.1
      set startIndex to 2
    end if
    repeat with i from startIndex to count argv by 2
      set tabTitle to item i of argv
      set tabCommand to item (i + 1) of argv
      set beforeId to id of front window
      my createNewTab()
      set newWindow to front window
      if (id of newWindow) is beforeId then error "TAB_AUTOMATION_FAILED"
      do script ("cd " & quoted form of workDir & "; " & tabCommand) in newWindow
      delay 0.35
      try
        set custom title of selected tab of newWindow to tabTitle
      end try
    end repeat
    activate
  end tell
end run
APPLESCRIPT
osascript_pid=$!
sleep "$TERMINAL_OPEN_WAIT_SECONDS"
if kill -0 "$osascript_pid" 2>/dev/null; then
  kill "$osascript_pid" 2>/dev/null || true
  rm -f "$osascript_log"
  printf 'Terminal tab creation timed out before A/B/C/D were attached.\n' >&2
  exit 2
fi
wait "$osascript_pid" || osascript_status=$?
osascript_status="${osascript_status:-0}"
osascript_output="$(cat "$osascript_log" 2>/dev/null || true)"
rm -f "$osascript_log"

if (( osascript_status != 0 )) || [[ "$osascript_output" == *"TAB_AUTOMATION_FAILED"* ]]; then
  if terminal_has_non_cbridge_windows; then
    printf 'Terminal could not create tabs automatically, and non-cbridge Terminal windows are open. Close or move those windows, then run cbridge-re-terminal again.\n' >&2
    exit 2
  fi
  printf 'Terminal could not create tabs automatically. Run cbridge-re-terminal again after Terminal can create tabs from the Shell menu.\n' >&2
  exit 2
fi

printf '%s\n' "$(date +%s)" > "$TERMINAL_TABS_STATE"
printf 'cbridge leader tabs opened in Terminal.app\n'
